# RePart environment variables — NAMES ONLY. Never put real values in this file.
# Copy to .env and fill in locally. .env is git-ignored and must never be committed.

# ── Database (Supabase DEVELOPMENT project, Mumbai) ─────────────
# Pooled connection (Supavisor) used by the app at runtime.
DATABASE_URL=
# Direct connection used only by Prisma CLI for migrations.
DIRECT_URL=

# ── Automated tests (local Docker postgres-test ONLY; never Supabase) ──
# e.g. postgresql://repart:<local password from docker-compose.yml>@127.0.0.1:54329/repart_test
TEST_DATABASE_URL=

# ── Supabase (server-side only; used for Storage) ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional and not read by the app: only for a manual RLS smoke test against the public API.
SUPABASE_ANON_KEY=

# ── Storage ────────────────────────────────────────────────────
# supabase (default) | minio | memory (tests only)
STORAGE_PROVIDER=
STORAGE_BUCKET_LISTING_PHOTOS=
STORAGE_BUCKET_INSPECTION_PHOTOS=
STORAGE_BUCKET_DISPUTE_EVIDENCE=
STORAGE_BUCKET_CATALOGUE_IMPORTS=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Redis / BullMQ ──────────────────────────────────────────────
REDIS_URL=

# ── App ────────────────────────────────────────────────────────
APP_BASE_URL=
# At least 32 random characters.
SESSION_SECRET=
LOG_LEVEL=

# ── Provider adapters (all default to mock; payment also supports cashfree) ──
OTP_PROVIDER=
PAYMENT_PROVIDER=
SHIPPING_PROVIDER=
VISION_PROVIDER=
NOTIFICATION_PROVIDER=
# At least 16 characters each; the mock payment provider and mock courier sign their webhooks with these.
MOCK_WEBHOOK_SECRET=
SHIPPING_WEBHOOK_SECRET=

# ── Cashfree (M8, TEST/SANDBOX credentials only) ──────────────
# Server-only. Set both or neither. Never prefix with NEXT_PUBLIC_.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── End-to-end tests only (optional) ────────────────────────────
# npm run test:e2e sets its own NODE_ENV, database, Redis DB 1, mock providers and webhook secrets
# (tests/e2e/support/env.ts). Photo journeys use the Supabase DEVELOPMENT storage configured above
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY); objects the run creates are deleted at the end.
# E2E_REUSE_SERVER=1 reuses an e2e server already running on port 3100.
E2E_REUSE_SERVER=
# Folder name under screenshots/ (default m13).
SCREENSHOT_MILESTONE=
